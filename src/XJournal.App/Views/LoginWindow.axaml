<c:JournalWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="using:XJournal.App.Controls"
                 xmlns:vm="using:XJournal.App.ViewModels"
                 xmlns:fa="using:FluentAvalonia.UI.Controls"
                 x:Class="XJournal.App.Views.LoginWindow"
                 x:DataType="vm:LoginViewModel"
                 Title="xJournal"
                 Width="520" Height="720" MinWidth="440" MinHeight="600"
                 WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="36,*">
    <TextBlock Classes="app-title titlebar" Text="xJournal" IsHitTestVisible="False" />

    <ScrollViewer Grid.Row="1">
      <Border Classes="card" Width="380" Padding="32,28" Margin="0,8,0,24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <Image Source="avares://xJournal/Assets/xjournal.png" Width="56" Height="56"
                   HorizontalAlignment="Left" Margin="-4,0,0,0" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Classes="title" Margin="0,8,0,0" Text="{Binding Heading}" />
            <TextBlock Classes="secondary" Text="Your private, automatic journal." />
          </StackPanel>

          <fa:FAInfoBar Severity="Warning" IsClosable="True" Message="{Binding Notice}"
                        IsOpen="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}, Mode=OneWay}" />

          <StackPanel Spacing="6">
            <TextBlock Text="Username" />
            <AutoCompleteBox Name="UsernameBox" Text="{Binding Username}" ItemsSource="{Binding Accounts}"
                             FilterMode="StartsWith" MinimumPrefixLength="0" PlaceholderText="Your name" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Password" />
            <TextBox Name="PasswordBox" Text="{Binding Password}" PasswordChar="●"
                     Classes="revealPasswordButton" PlaceholderText="Password" />
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding IsCreateMode}">
            <TextBlock Text="Confirm password" />
            <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" Classes="revealPasswordButton"
                     PlaceholderText="Type it again" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Your password encrypts your journal. There's no way to recover it, so keep it somewhere safe." />
          </StackPanel>

          <TextBlock Classes="error" Text="{Binding Error}"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Button Classes="accent" IsDefault="True" HorizontalAlignment="Stretch" Height="36"
                  Command="{Binding SubmitCommand}">
            <Panel>
              <TextBlock Text="{Binding PrimaryText}" HorizontalAlignment="Center"
                         IsVisible="{Binding !IsBusy}" />
              <fa:FAProgressRing IsIndeterminate="True" Width="18" Height="18"
                                 IsVisible="{Binding IsBusy}"
                                 Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Panel>
          </Button>

          <HyperlinkButton HorizontalAlignment="Center" Content="{Binding SwitchModeText}"
                           Command="{Binding SwitchModeCommand}" />

          <Separator Margin="0,-4" />

          <HyperlinkButton HorizontalAlignment="Center" Command="{Binding ImportJournalCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fa:FASymbolIcon Symbol="Import" FontSize="14" />
              <TextBlock Text="Import a journal from a backup…" />
            </StackPanel>
          </HyperlinkButton>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</c:JournalWindow>
