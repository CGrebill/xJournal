<c:JournalWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="using:XJournal.App.Controls"
                 xmlns:vm="using:XJournal.App.ViewModels"
                 xmlns:fa="using:FluentAvalonia.UI.Controls"
                 x:Class="XJournal.App.Views.TrendsWindow"
                 x:DataType="vm:TrendsViewModel"
                 Title="Trends · xJournal"
                 Width="1000" Height="640" MinWidth="720" MinHeight="460"
                 WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="36,Auto,*">
    <TextBlock Classes="app-title titlebar" Text="Trends" IsHitTestVisible="False" />

    <Grid Grid.Row="1" Margin="24,8,24,16" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="title" Text="Trends" />
        <TextBlock Classes="secondary" Text="How your answers have changed over time." />
      </StackPanel>
      <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="160"
                ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" />
    </Grid>

    <Grid Grid.Row="2" Margin="24,0,24,24" ColumnDefinitions="280,16,*" IsVisible="{Binding HasQuestions}">
      <Border Classes="card" Padding="6">
        <ListBox ItemsSource="{Binding Questions}" SelectedItem="{Binding SelectedQuestion}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TrendQuestion">
              <StackPanel Spacing="2" Margin="2,4">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="Archived" IsVisible="{Binding IsArchived}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2" Classes="card" Padding="20">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
          <TextBlock Classes="subtitle" TextWrapping="Wrap" Text="{Binding SelectedQuestion.Text, FallbackValue=''}" />
          <TextBlock Grid.Row="1" Classes="secondary" Margin="0,4,0,12" Text="{Binding Stats}" />
          <c:TrendChart Grid.Row="2" Name="Chart" Points="{Binding Points}" From="{Binding From}" To="{Binding To}" />
          <ItemsControl Grid.Row="3" Margin="0,12,0,0" ItemsSource="{Binding Legend}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="18" LineSpacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="caption" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Grid.Row="4" Classes="caption" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding VersionNote}"
                     IsVisible="{Binding VersionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="card" Margin="24,0,24,24" Padding="32" VerticalAlignment="Top"
            IsVisible="{Binding !HasQuestions}">
      <StackPanel Spacing="8">
        <fa:FASymbolIcon Symbol="CalendarMonth" FontSize="32" HorizontalAlignment="Left" />
        <TextBlock Classes="subtitle" Text="Nothing to chart yet" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="Import some questions from the check-in window and answer them each day. Your trends will show up here." />
      </StackPanel>
    </Border>
  </Grid>
</c:JournalWindow>
