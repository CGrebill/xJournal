<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XJournal.App.ViewModels"
             x:Class="XJournal.App.Views.QuestionImportPreviewView"
             x:DataType="vm:QuestionImportPreviewViewModel"
             Width="460">
  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:PreviewLine">
      <StackPanel Spacing="2" Margin="0,2">
        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <ScrollViewer MaxHeight="440">
    <StackPanel Spacing="14">
      <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Headline}" />

      <CheckBox IsChecked="{Binding ArchiveMissing}" IsVisible="{Binding HasExisting}">
        <TextBlock TextWrapping="Wrap"
                   Text="Replace my question set: archive questions that aren't in this file (their answers are kept)" />
      </CheckBox>

      <StackPanel Spacing="4" IsVisible="{Binding HasAdded}">
        <TextBlock Classes="body-strong" Text="New questions" />
        <ItemsControl ItemsSource="{Binding Added}" />
      </StackPanel>

      <StackPanel Spacing="4" IsVisible="{Binding HasChanged}">
        <TextBlock Classes="body-strong" Text="Reworded (a new version is added; old answers keep the old wording)" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Changed}" />
      </StackPanel>

      <StackPanel Spacing="4" IsVisible="{Binding HasArchived}">
        <TextBlock Classes="body-strong" Text="Archived (hidden from the check-in, history kept)" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Archived}" />
      </StackPanel>

      <TextBlock Classes="caption" Text="{Binding UnchangedText}"
                 IsVisible="{Binding UnchangedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
