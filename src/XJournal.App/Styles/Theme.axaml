<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <x:Double x:Key="EditorFontSize">16</x:Double>
  </Styles.Resources>

  <!-- Typography -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body-strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Title strip at the top of each window (content is drawn into the title bar) -->
  <Style Selector=":is(Control).titlebar">
    <Setter Property="Margin" Value="16,0" />
  </Style>
  <!-- macOS draws its window buttons at the top left -->
  <Style Selector="Window.macos :is(Control).titlebar">
    <Setter Property="Margin" Value="80,0,16,0" />
  </Style>
  <Style Selector="TextBlock.app-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- Surfaces: translucent cards layered over the Mica backdrop -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.layer">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
  </Style>
  <Style Selector="Border.solid">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
  </Style>

  <!-- Tile buttons for the main window's right-hand column -->
  <Style Selector="Button.tile">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>
  <Style Selector="Button.tile.accent">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
  </Style>

  <!-- Borderless text boxes that sit inside a card (the journal editor and summary) -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.editor">
    <Setter Property="FontSize" Value="{StaticResource EditorFontSize}" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="AcceptsTab" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Check-in answers (ratings, scales, yes/no): pill buttons laid out in a row -->
  <Style Selector="RadioButton.choice">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Pill"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="6,8" MinHeight="58">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Name="PART_Number" Text="{TemplateBinding Tag}" HorizontalAlignment="Center"
                       FontWeight="SemiBold" FontSize="16" />
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                              TextElement.FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.choice:pointerover /template/ Border#PART_Pill">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="RadioButton.choice:checked /template/ Border#PART_Pill">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>
  <Style Selector="RadioButton.choice:checked /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton.choice:checked /template/ TextBlock#PART_Number">
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
  </Style>
  <!-- Buttons with no label underneath (scale numbers, yes/no) -->
  <Style Selector="RadioButton.choice.compact /template/ Border#PART_Pill">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="4,6" />
  </Style>
  <Style Selector="RadioButton.choice.compact /template/ ContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Choice options: rounded toggles that wrap onto more lines -->
  <Style Selector="ToggleButton.option">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Selectable chips (date presets) -->
  <Style Selector="Button.chip">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Calendar day cells -->
  <Style Selector="Button.day">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.day.outside">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.day.today">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>
  <Style Selector="Button.day.selected">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="Button.day.selected:not(.today)">
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
  </Style>

  <!-- Search results -->
  <Style Selector="ListBox.results">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.results ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
</Styles>
